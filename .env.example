# Copy this file to .env and replace the placeholder values.
# Do not commit your real .env file to GitHub.

# Security
SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-characters
ALGORITHM=HS256
COOKIE_SECURE=false

# Database
DATABASE_URL=sqlite:///./database.db

# JWT / auth timings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Login / rate limiting
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=1
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_MINUTE=5

# API
API_TITLE=URL Shortener API
API_VERSION=1.0.0

# URL expiration
DEFAULT_URL_EXPIRATION_DAYS=30

# CSRF
CSRF_HEADER_NAME=X-CSRF-Token
